BOT_TOKEN=
DB_PATH=dance.sqlite3
# Postgres DSN (asyncpg driver). Обязателен — без него старт падает с понятной
# ошибкой. Локально: `docker compose up -d` (см. docker-compose.yml) или
# native-инстанс (см. DEVELOPMENT.md).
DATABASE_URL=postgresql+asyncpg://dancepulse:dancepulse@localhost:5432/dancepulse
TIMEZONE=Europe/Moscow
DEFAULT_LEAD_HOURS=18
LOG_LEVEL=INFO
# Telegram user_id разработчика(ов) — CSV, можно несколько через запятую
# (напр. 111111111,222222222). Даёт доступ к /grant, /status, /devstats,
# dev-режиму (Phase 10).
DEVELOPER_TG_IDS=0

# Самостоятельный онбординг препода: если задан секрет, владелец школы пишет боту
# `/claim <секрет>` и сразу получает статус препода — без ручного /grant. Пусто =
# выключено. Меняй секрет между пилотами.
OWNER_CLAIM_SECRET=
# Контакт для нового препода (@username/ссылка) — подставляется в приветствие
# нераспознанному пользователю вместо «передай ID разработчику». Пусто = дефолт.
DEVELOPER_CONTACT=

# ── E2E: живые тесты через Telethon (опц., см. e2e/README.md) ──
# api_id/api_hash — на https://my.telegram.org → API development tools
E2E_API_ID=
E2E_API_HASH=
# заполнится после: python -m e2e.live.login
E2E_SESSION=
E2E_BOT_USERNAME=dancepulsebot
